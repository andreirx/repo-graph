# Dependencies
node_modules/

# Build output
dist/
build/

# TypeScript cache
*.tsbuildinfo

# Rust build output (cargo).
# Cargo.lock IS committed because the workspace will produce binary
# artifacts (the daemon CLI). This matches the Node toolchain pinning
# discipline: exact, reproducible builds across contributors.
# Broad pattern covers workspace, fixture crates, and any nested Cargo projects.
**/target/

# SQLite databases (local working data, not committed)
*.db
*.db-journal
*.db-wal
*.db-shm

# Artifact store (heavy evidence files)
artifacts/

# Daemon-local artifacts: warm cache (.rgr/warm-cache/) + livegraph compare sidecars
# (.rgr/livegraph-compare/). Repo-local, disposable, regenerated by the daemon — never committed.
.rgr/

# Smoke-run outputs (field-calibration logs, per-run timestamped folders).
# The README is kept in-tree as documentation; individual runs are local only.
smoke-runs/*
!smoke-runs/README.md

# Audit working documents (local analysis, not committed)
docs/audits/

# Python virtual environments (for optional analysis pipelines)
tools/python/venv/
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Test coverage (root-level only, not rust/crates/coverage/)
/coverage/

# npm
*.tgz

# Logs
*.log
npm-debug.log*

# rgistr generated summaries (local discovery artifacts, not committed)
# File-scope MAPs: {basename}_{ext}_MAP.md
*_*_MAP.md
# Folder-scope MAPs in rgistr tool output areas
tools/rgistr/**/MAP.md
*MAP.md
# DATAFLOW-HOTPATH-MAP-1 is a TRACKED architecture doc, NOT an rgistr artifact — the *MAP.md rule
# above catches it case-insensitively on macOS (APFS). Keep it tracked.
!docs/architecture/dataflow-hotpath-map.md
